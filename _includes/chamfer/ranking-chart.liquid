{%- comment -%}
  Ranking chart: the paper's Figure 9 made interactive. Chamfer-Fidelity across,
  Chamfer-Coverage up, one mark per model, filters above, zoom and pan inside,
  and beside it a panel for the model being hovered (or tapped): its numbers and
  its generated samples closest to and farthest from the real images, which are
  only downloaded then.

  The numbers come from _data/chamfer_models.json, written from the paper's
  table by bin/chamfer_table_to_json.py; families, their marks and the models
  shown first are set in _data/chamfer_chart.yml. Samples are whatever images
  sit in assets/chamfer-samples/<model id>/ (closest-01.webp, ...,
  farthest-01.webp, ...). Drawn by assets/js/chamfer-ranking-chart.js.
  Pass caption="..." to put a caption under it. The frame, the filter chips,
  the Models menu and the zoom buttons come from chamfer/controls.liquid.
{%- endcomment -%}
{%- assign rk_samples = site.static_files | where_exp: 'f', "f.path contains '/assets/chamfer-samples/'" | map: 'path' -%}
{% include chamfer/controls.liquid %}
<style>
  .rk {
    --rk-orange: #eb6834;
    --rk-blue: #2a78d6;
    --rk-green: #1baf7a;
    --rk-square: #898781;
    --rk-ring: var(--global-text-color-light);
    --rk-tint: rgba(0, 0, 0, 0.04);
  }
  html[data-theme='dark'] .rk {
    --rk-orange: #d95926;
    --rk-blue: #3987e5;
    --rk-green: #199e70;
    --rk-tint: rgba(255, 255, 255, 0.06);
  }
  /* A row of filters across the top; the chart and the panel side by side under it. */
  .rk-controls {
    position: relative;
    margin-bottom: 0.75rem;
  }
  .rk-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .rk-families {
    display: contents;
  }
  /* A family's chip: on, it has a darker edge; off, it and its key fade. */
  .rk-chip[aria-pressed='false'] {
    color: var(--global-text-color-light);
  }
  .rk-chip[aria-pressed='false'] .rk-key {
    opacity: 0.35;
  }
  .rk-chip[aria-pressed='true'],
  .rk-chip[aria-pressed='mixed'] {
    border-color: var(--global-text-color-light);
  }
  /* The menu opens under the whole row, from its left edge. */
  body d-article .rk .rk-pick {
    position: static;
    display: block;
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }
  body d-article .rk .rk-pick > summary {
    color: var(--global-text-color);
  }
  .rk-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    width: min(34rem, 100%);
    max-height: min(26rem, 70vh);
    overflow-y: auto;
    padding: 0.9rem 1rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 10px;
    background: var(--global-bg-color);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    font-size: 0.82rem;
  }
  @media (max-width: 560px) {
    .rk-menu {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .rk-menu fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .rk-menu legend {
    margin-bottom: 0.3rem;
    padding: 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--global-text-color-light);
  }
  .rk-menu label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.12rem 0;
    cursor: pointer;
    color: var(--global-text-color);
  }
  .rk-menu input {
    margin: 0;
    accent-color: var(--global-theme-color);
  }
  .rk-presets {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--global-divider-color);
  }

  /* Family keys: the mark each family is drawn with. */
  .rk-key {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--rk-c);
  }
  .rk-key[data-mark='square'] {
    border-radius: 2px;
  }
  .rk-key[data-mark='ring'] {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--rk-c);
  }
  [data-mark='orange'] {
    --rk-c: var(--rk-orange);
  }
  [data-mark='blue'] {
    --rk-c: var(--rk-blue);
  }
  [data-mark='green'] {
    --rk-c: var(--rk-green);
  }
  [data-mark='square'] {
    --rk-c: var(--rk-square);
  }
  [data-mark='ring'] {
    --rk-c: var(--rk-ring);
  }

  /* Chart and panel side by side, the panel as tall as the chart; stacked on
     narrow screens. */
  .rk-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 860px) {
    .rk-body {
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
      gap: 1.75rem;
    }
    .rk-panel {
      contain: size;
      overflow: hidden;
    }
  }
  .rk-plot {
    position: relative;
    min-width: 0;
  }
  .rk-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .rk-grid line {
    stroke: var(--global-divider-color);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .rk-axis text,
  .rk-better text {
    fill: var(--global-text-color-light);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .rk-axis .rk-title {
    font-size: 12px;
    fill: var(--global-text-color-light);
  }
  .rk-better line {
    stroke: var(--global-text-color-light);
    stroke-width: 1.5;
    opacity: 0.6;
  }
  .rk-better path {
    fill: var(--global-text-color-light);
    opacity: 0.6;
  }
  .rk-dot {
    cursor: pointer;
    outline: none;
    transition: opacity 0.3s ease;
  }
  .rk-dot.rk-off {
    opacity: 0;
    pointer-events: none;
  }
  .rk-mark {
    fill: var(--rk-c);
    stroke: var(--global-bg-color);
    stroke-width: 2;
  }
  .rk-dot[data-mark='ring'] .rk-mark {
    fill: var(--global-bg-color);
    fill-opacity: 0.6;
    stroke: var(--rk-c);
    stroke-width: 2;
  }
  .rk-dot.rk-unknown .rk-mark {
    fill-opacity: 0.35;
    stroke: var(--rk-c);
    stroke-width: 1.5;
    stroke-dasharray: 3 2.5;
  }
  .rk-ring {
    fill: none;
    stroke: var(--global-text-color);
    stroke-width: 2;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .rk-dot.rk-active .rk-ring,
  .rk-dot:focus-visible .rk-ring {
    opacity: 1;
  }
  .rk-label {
    fill: var(--global-text-color-light);
    font-size: 12px;
    paint-order: stroke;
    stroke: var(--global-bg-color);
    stroke-width: 3px;
    stroke-linejoin: round;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .rk-label.rk-hidden,
  .rk-leader.rk-hidden {
    opacity: 0;
  }
  .rk-leader {
    stroke: var(--global-text-color-light);
    stroke-width: 1;
    opacity: 0.6;
    transition: opacity 0.25s ease;
  }
  .rk-label.rk-active {
    fill: var(--global-text-color);
  }
  /* While the pointer is over the chart, everything but the model under it steps back. */
  .rk-svg.rk-hovering .rk-dot:not(.rk-active):not(.rk-off),
  .rk-svg.rk-hovering .rk-label:not(.rk-active):not(.rk-hidden) {
    opacity: 0.4;
  }
  .rk-zoom {
    position: absolute;
    z-index: 2;
    display: flex;
    gap: 0.5rem;
  }
  .rk-better .rk-zoom-hint {
    font-size: 10.5px;
    opacity: 0.85;
  }
  /* Over the chart, so the grid does not show through. */
  .rk-zoom .ch-btn {
    padding: 0 0.6rem;
    background-color: var(--global-bg-color);
  }
  .rk-svg.rk-grab {
    cursor: grab;
  }
  .rk-svg.rk-panning {
    cursor: grabbing;
  }
  .rk-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    color: var(--global-text-color-light);
    pointer-events: none;
  }

  /* Panel: the model under the pointer, with its samples. */
  .rk-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-size: 0.85rem;
  }
  .rk-hint {
    margin: 0;
    color: var(--global-text-color-light);
    line-height: 1.5;
  }
  .rk-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .rk-name {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--global-text-color);
  }
  /* The two Chamfer scores, on one line. */
  .rk-name {
    min-width: 0;
  }
  /* Parameters and NFE, small, at the right end of the name's line. */
  .rk-meta {
    margin-left: auto;
    font-size: 0.7rem;
    white-space: nowrap;
    color: var(--global-text-color-light);
  }
  .rk-scores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 1rem;
    margin: 0.35rem 0 0.7rem;
    font-size: 0.72rem;
    color: var(--global-text-color-light);
    font-variant-numeric: tabular-nums;
  }
  .rk-scores b {
    margin-left: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--global-text-color);
  }
  .rk-side {
    margin: 0 0 0.35rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--global-text-color-light);
  }
  .rk-side span {
    margin-left: 0.4rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  /* Each side is a strip of samples that scrolls sideways, in one row or two
     (the script picks by the strip's height); a sample is fetched as it
     scrolls into view. On a wide screen the two strips share the panel's
     height. */
  .rk-samples {
    min-width: 0;
  }
  @media (min-width: 860px) {
    .rk-samples {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto minmax(0, 1fr);
      flex: 1;
      min-height: 0;
    }
  }
  .rk-strip {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(var(--rk-rows, 1), var(--rk-size, 88px));
    grid-auto-columns: var(--rk-size, 88px);
    gap: 4px;
    box-sizing: border-box;
    height: 98px;
    min-height: 0;
    padding-bottom: 10px; /* the scrollbar's room, below the samples */
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }
  @media (min-width: 860px) {
    .rk-strip {
      height: auto;
    }
  }
  .rk-strip + .rk-side {
    margin-top: 0.6rem;
  }
  .rk-thumb {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: var(--rk-tint);
    scroll-snap-align: start;
  }
  .rk-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .rk-thumb img.rk-loaded {
    opacity: 1;
  }
  .rk-strip.rk-strip-soon {
    display: flex;
  }
  .rk-soon {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--global-divider-color);
    border-radius: 4px;
    color: var(--global-text-color-light);
  }
  .rk-instant .rk-dot,
  .rk-instant .rk-label,
  .rk-instant .rk-leader {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .rk-dot,
    .rk-ring,
    .rk-label,
    .rk-thumb img {
      transition: none;
    }
  }
</style>

<div class="rk ch-box l-page" data-ranking-chart>
  <div class="rk-controls">
    <div class="rk-filters" role="group" aria-label="Choose models">
      <div class="rk-families"></div>
      <details class="rk-pick ch-menu">
        <summary class="ch-btn">Models</summary>
        <div class="rk-menu"></div>
      </details>
    </div>
  </div>
  <div class="rk-body">
    <div class="rk-plot"></div>
    <div class="rk-panel" aria-live="polite"></div>
  </div>
  <script type="application/json" class="rk-data">
    {
      "families": {{ site.data.chamfer_chart.families | jsonify }},
      "figure": {{ site.data.chamfer_chart.figure | jsonify }},
      "models": {{ site.data.chamfer_models.models | jsonify }},
      "samples": {{ rk_samples | jsonify }},
      "base": {{ site.baseurl | jsonify }}
    }
  </script>
</div>
{%- if include.caption %}
  <div class="caption ch-caption">{{ include.caption }}</div>
{%- endif %}
<script defer src="{{ '/assets/js/chamfer-ranking-chart.js' | relative_url }}"></script>
