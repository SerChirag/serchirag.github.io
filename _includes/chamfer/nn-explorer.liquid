{%- comment -%}
  A nearest-neighbour explorer: the paper's Figures 6 and 7 made interactive.
  It states the test (for an image from one set, find its nearest neighbours in
  the other), and shows a query image beside its three nearest neighbours. The
  reader picks a class and one of its three query images, whose nearest
  neighbours run from close to far; the images, their distances, a distance
  line and a comment change to match.
  Drawn by assets/js/chamfer-nn-explorer.js.

  Parameters:
    direction  fidelity (a generated query, real neighbours; Figure 6) or
               coverage (a real query, generated neighbours; Figure 7).
               Default fidelity.
    caption    optional; a caption under the box

  The images and distances are in _data/chamfer_nn_examples.json, written by
  bin/chamfer_nn_examples.py. The words are in _data/chamfer_nn_text.yml.
  The styles and script are added once per page, however many explorers it has.
{%- endcomment -%}
{%- assign nnx_dir = include.direction | default: 'fidelity' -%}
{%- assign nnx_text = site.data.chamfer_nn_text[nnx_dir] -%}
{%- unless nnx_assets_added %}
  <style>
    .nnx {
      --nnx-real: #2f80ed;
      --nnx-gen: #f08a2c;
      --nnx-good: #2e9d5b;
      --nnx-mid: #c98a12;
      --nnx-bad: #d64545;
      margin: 2rem 0;
      padding: 1.1rem 1.25rem 1rem;
      border: 1px solid var(--global-divider-color);
      border-radius: 14px;
    }
    /* The query's set and the neighbours' set, by direction. */
    .nnx[data-direction='fidelity'] {
      --nnx-q: var(--nnx-gen);
      --nnx-n: var(--nnx-real);
    }
    .nnx[data-direction='coverage'] {
      --nnx-q: var(--nnx-real);
      --nnx-n: var(--nnx-gen);
    }
    body d-article .nnx-caption {
      margin-top: -1.25rem;
      color: var(--global-text-color-light);
    }
    body d-article .nnx-test {
      margin: 0 0 0.9rem;
      font-size: 1.02rem;
      line-height: 1.5;
      color: var(--global-text-color);
    }
    body d-article .nnx-intro {
      font-weight: 700;
      color: var(--global-text-color);
    }
    body d-article .nnx b.nnx-gen {
      color: var(--nnx-gen);
    }
    body d-article .nnx b.nnx-real {
      color: var(--nnx-real);
    }
    /* The two choices: the class, and the query image. */
    .nnx-controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem 1.5rem;
      margin-bottom: 1rem;
    }
    .nnx-group {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .nnx-group-label {
      margin: 0;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--global-text-color-light);
    }
    /* The class: a dropdown, drawn as a pill with a chevron. */
    .nnx-select {
      position: relative;
      display: inline-block;
    }
    .nnx-select::after {
      content: '';
      position: absolute;
      top: 50%;
      right: 0.85rem;
      width: 0.4rem;
      height: 0.4rem;
      margin-top: -0.3rem;
      border-right: 2px solid var(--global-theme-color);
      border-bottom: 2px solid var(--global-theme-color);
      transform: rotate(45deg);
      pointer-events: none;
    }
    .nnx-select select {
      -webkit-appearance: none;
      appearance: none;
      margin: 0;
      border: 1px solid var(--global-theme-color);
      border-radius: 999px;
      padding: 0.25rem 2.1rem 0.25rem 0.9rem;
      font: inherit;
      color: var(--global-theme-color);
      background: transparent;
      cursor: pointer;
    }
    .nnx-select select:hover {
      background: rgba(85, 63, 195, 0.1);
      background: color-mix(in srgb, var(--global-theme-color) 12%, transparent);
    }
    .nnx-select option {
      color: var(--global-text-color);
      background: var(--global-bg-color);
    }
    /* The query image: the class's three, as small pictures; the picked one is framed. */
    .nnx-picks {
      display: inline-flex;
      gap: 0.4rem;
    }
    .nnx-pick {
      margin: 0;
      padding: 2px;
      border: 2px solid transparent;
      border-radius: 8px;
      line-height: 0;
      background: transparent;
      opacity: 0.55;
      cursor: pointer;
      transition:
        opacity 0.2s,
        border-color 0.2s;
    }
    .nnx-pick:hover {
      opacity: 0.85;
    }
    .nnx-pick[aria-checked='true'] {
      border-color: var(--nnx-q);
      opacity: 1;
    }
    .nnx-pick img {
      display: block;
      width: 2.6rem;
      height: 2.6rem;
      object-fit: cover;
      border-radius: 5px;
    }
    /* The query and its three nearest neighbours, in one row. */
    .nnx-stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 2rem repeat(3, minmax(0, 1fr));
      column-gap: 0.6rem;
      row-gap: 0.35rem;
      align-items: end;
    }
    .nnx-label {
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1.3;
    }
    .nnx-label-query {
      grid-column: 1;
      color: var(--nnx-q);
    }
    .nnx-label-nn {
      grid-column: 3 / -1;
      color: var(--nnx-n);
    }
    .nnx-tile {
      display: grid;
      padding: 3px;
      border: 2px solid var(--nnx-n);
      border-radius: 8px;
      background: var(--global-bg-color);
    }
    .nnx-tile-query {
      grid-column: 1;
      border-color: var(--nnx-q);
    }
    .nnx-tile img {
      grid-area: 1 / 1;
      display: block;
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 5px;
    }
    .nnx-tile img.nnx-in {
      animation: nnx-fade 0.3s ease-out;
    }
    @keyframes nnx-fade {
      from {
        opacity: 0;
      }
    }
    .nnx-arrow {
      grid-column: 2;
      align-self: center;
      justify-self: center;
      width: 100%;
      color: var(--global-text-color-light);
    }
    .nnx-arrow svg {
      display: block;
      width: 100%;
      height: auto;
    }
    .nnx-d {
      font-size: 0.82rem;
      text-align: center;
      font-variant-numeric: tabular-nums;
      color: var(--global-text-color);
    }
    .nnx-d-query {
      grid-column: 1;
    }
    /* The distance line: the query at 0, its neighbours at their distances. */
    .nnx-ruler {
      position: relative;
      height: 3.5rem;
      margin: 1.1rem 0.4rem 0;
    }
    .nnx-track,
    .nnx-span {
      position: absolute;
      top: 0.5rem;
      left: 0;
      height: 2px;
      margin-top: -1px;
    }
    .nnx-track {
      right: 0;
      background: var(--global-divider-color);
    }
    .nnx-span {
      height: 4px;
      margin-top: -2px;
      border-radius: 2px;
      background: var(--nnx-n);
      opacity: 0.45;
    }
    .nnx-dot {
      position: absolute;
      top: 0.5rem;
      width: 12px;
      height: 12px;
      margin: -6px 0 0 -6px;
      border: 2px solid var(--global-bg-color);
      border-radius: 50%;
      background: var(--nnx-n);
      box-sizing: border-box;
    }
    .nnx-dot-query {
      left: 0;
      width: 14px;
      height: 14px;
      margin: -7px 0 0 -7px;
      background: var(--nnx-q);
    }
    /* Each tick hangs from the line, its number just under it; the axis labels sit
       clear of the numbers, at the bottom. */
    .nnx-tick {
      position: absolute;
      top: 1rem;
      transform: translateX(-50%);
      font-size: 0.72rem;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      color: var(--global-text-color-light);
    }
    .nnx-tick::before {
      content: '';
      position: absolute;
      top: -0.5rem;
      left: 50%;
      width: 1px;
      height: 0.35rem;
      background: var(--global-divider-color);
    }
    .nnx-axis {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      line-height: 1.2;
      color: var(--global-text-color-light);
    }
    .nnx-animate .nnx-span,
    .nnx-animate .nnx-dot:not(.nnx-dot-query) {
      transition-duration: 0.55s;
      transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    .nnx-animate .nnx-span {
      transition-property: width;
    }
    .nnx-animate .nnx-dot {
      transition-property: left;
    }
    /* The comment, tinted by how close the nearest neighbour is. */
    .nnx-says {
      margin-top: 0.8rem;
      padding: 0.6rem 0.8rem;
      border-radius: 10px;
      background: rgba(127, 127, 127, 0.08);
      background: color-mix(in srgb, var(--nnx-level) 10%, transparent);
      font-size: 0.95rem;
      line-height: 1.45;
      color: var(--global-text-color);
    }
    .nnx[data-level='0'] {
      --nnx-level: var(--nnx-good);
    }
    .nnx[data-level='1'] {
      --nnx-level: var(--nnx-mid);
    }
    .nnx[data-level='2'] {
      --nnx-level: var(--nnx-bad);
    }
    .nnx-says-text {
      display: block;
    }
    .nnx-says-text.nnx-in {
      animation: nnx-fade 0.3s ease-out;
    }
    body d-article .nnx-size {
      font-weight: 700;
      color: var(--nnx-level);
    }
    @media (max-width: 560px) {
      .nnx {
        padding: 0.9rem 0.8rem 0.8rem;
      }
      .nnx-stage {
        grid-template-columns: minmax(0, 1fr) 1rem repeat(3, minmax(0, 1fr));
        column-gap: 0.35rem;
      }
      .nnx-label,
      .nnx-d {
        font-size: 0.72rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .nnx * {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>
{%- endunless %}
<div class="nnx l-page" data-nn-explorer data-direction="{{ nnx_dir }}" data-level="0">
  <p class="nnx-test">
    {%- if nnx_text.intro -%}
      <strong class="nnx-intro">{{ nnx_text.intro }}</strong>
    {% endif -%}
    {{ nnx_text.test }}
  </p>
  <div class="nnx-controls">
    <div class="nnx-group">
      <label class="nnx-group-label" for="nnx-{{ nnx_dir }}-class">Class</label>
      <span class="nnx-select"><select class="nnx-classes" id="nnx-{{ nnx_dir }}-class"></select></span>
    </div>
    <div class="nnx-group">
      <span class="nnx-group-label" id="nnx-{{ nnx_dir }}-pick">{{ nnx_text.pick }}</span>
      <div class="nnx-picks" role="radiogroup" aria-labelledby="nnx-{{ nnx_dir }}-pick"></div>
    </div>
  </div>
  <div class="nnx-stage">
    <div class="nnx-label nnx-label-query">{{ nnx_text.query }}</div>
    <div class="nnx-label nnx-label-nn">{{ nnx_text.neighbours }}</div>
    <div class="nnx-tile nnx-tile-query"></div>
    <div class="nnx-arrow" aria-hidden="true">
      <svg viewBox="0 0 32 16">
        <path d="M2 8h26M21 2l7 6-7 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
    <div class="nnx-tile"></div>
    <div class="nnx-tile"></div>
    <div class="nnx-tile"></div>
    <div class="nnx-d nnx-d-query"></div>
    <div></div>
    <div class="nnx-d"><i>d</i> = <span>0.00</span></div>
    <div class="nnx-d"><i>d</i> = <span>0.00</span></div>
    <div class="nnx-d"><i>d</i> = <span>0.00</span></div>
  </div>
  <div class="nnx-ruler" aria-hidden="true">
    <div class="nnx-track"></div>
    <div class="nnx-span"></div>
    <div class="nnx-dot nnx-dot-query"></div>
    <div class="nnx-dot"></div>
    <div class="nnx-dot"></div>
    <div class="nnx-dot"></div>
    <div class="nnx-axis">
      <span>&larr; Closer</span><span>{{ nnx_text.axis }}</span><span>Farther &rarr;</span>
    </div>
  </div>
  <div class="nnx-says" aria-live="polite"><span class="nnx-says-text"></span></div>
  <script type="application/json" class="nnx-data">
    {"data": {{ site.data.chamfer_nn_examples[nnx_dir] | jsonify }}, "x_max": {{ site.data.chamfer_nn_examples.x_max | jsonify }}, "text": {{ nnx_text | jsonify }}, "images": {{ '/assets/chamfer-nn/' | relative_url | jsonify }}}
  </script>
</div>
{%- if include.caption %}
  <div class="caption nnx-caption">{{ include.caption }}</div>
{%- endif %}
{%- unless nnx_assets_added %}
  <script defer src="{{ '/assets/js/chamfer-nn-explorer.js' | relative_url }}"></script>
  {%- assign nnx_assets_added = true -%}
{%- endunless %}
