{%- comment -%}
  A distance plot with a nearest-sample explorer: the paper's Figures 11 and 12
  made interactive. The chart shows, one curve per model, how far each sample
  lies from its nearest neighbour in the other set. A marker on the distance
  axis picks a distance, and the square grid beside the chart shows the sample
  nearest to it: for Figure 11 (Chamfer-Fidelity) each model's generated
  sample; for Figure 12 (Chamfer-Coverage) a real image and the model's sample
  nearest to it. The whole box is sized to fit the window. Drawn by assets/js/chamfer-fidelity-density.js.

  Parameters, all optional:
    data     the _data file to draw (default chamfer_fidelity_density). Each
             sample has `d` and `file`; samples with `real` too are shown as pairs.
             bin/chamfer_figure_data.py writes these files from the paper's export.
             A file with `classes` (each an id, a name and its own `models`, the
             same models in each) gets a dropdown to pick the class.
    images   the folder that `file` and `real` are relative to
             (default /assets/chamfer-fidelity/)
    note     the line above the grid
    stack    the images in one column beside the chart, one above the
             other, so the chart can be wider and shorter (for two models)
    caption  a caption under the box

  Only the images on show are loaded. The styles and script are added once per
  page, however many of these the page has. The frame, the dropdown and its
  label come from chamfer/controls.liquid.
{%- endcomment -%}
{%- assign cfd_data = include.data | default: 'chamfer_fidelity_density' -%}
{%- assign cfd_images = include.images | default: '/assets/chamfer-fidelity/' -%}
{%- assign cfd_note = include.note | default: 'For each model, the generated image whose distance is closest to the marker.' -%}
{% include chamfer/controls.liquid %}
{%- unless cfd_assets_added %}
  <style>
    /* Above the chart: the class dropdown (when the data has classes), then the key. */
    .cfd-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem 1.25rem;
      margin-bottom: 0.75rem;
    }
    /* The key: a line per model in its colour, and the dashed line for a mean. */
    .cfd-key {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem 1rem;
      font-size: 0.75rem;
      color: var(--global-text-color);
    }
    .cfd-key-item {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .cfd-key-item svg {
      flex: none;
      width: 22px;
      height: 10px;
    }
    .cfd-key-mean {
      color: var(--global-text-color-light);
    }
    /* Chart and panel stack; when the box is wide enough the panel sits to the right (see the script). */
    .cfd-body {
      display: grid;
      gap: 1rem;
    }
    .cfd.cfd-wide .cfd-body {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 1.25rem;
    }
    /* The images in one column (stack) beside a wider chart. The script sets the image's size and
       the panel's top padding, so the column starts level with the plot, and moves the note under the key. */
    .cfd.cfd-beside .cfd-body {
      grid-template-columns: minmax(0, 1fr) var(--cfd-tile, 150px);
    }
    .cfd.cfd-beside .cfd-panel {
      grid-template-columns: minmax(0, 1fr);
    }
    /* The theme script animates every property for a moment when a page loads (html.transition);
       the layout is set then, so the image column and the marker's handle (whose y is a CSS
       property) would slide into place. */
    html.transition .cfd .cfd-body,
    html.transition .cfd .cfd-panel,
    html.transition .cfd-chart * {
      transition: none !important;
    }
    .cfd-bar .cfd-panel-note {
      flex-basis: 100%;
    }
    .cfd-plot {
      min-width: 0;
    }
    /* The chart is drawn at its width in pixels, so its text keeps one size. */
    .cfd-chart {
      display: block;
      width: 100%;
      touch-action: pan-y;
      user-select: none;
      -webkit-user-select: none;
    }
    .cfd-chart text {
      font-family: inherit;
      fill: var(--global-text-color-light);
    }
    .cfd-chart.cfd-on-plot {
      cursor: pointer;
    }
    .cfd-chart.cfd-on-marker,
    .cfd-chart.cfd-dragging {
      cursor: ew-resize;
    }
    /* How to use it, in the chart's top-right corner; it gives way to a mean's label while a model is highlighted. */
    .cfd-hint {
      transition: opacity 0.2s ease;
    }
    .cfd-chart.cfd-focusing .cfd-hint {
      opacity: 0;
    }
    .cfd-grid {
      stroke: var(--global-divider-color);
      stroke-width: 1;
    }
    .cfd-axis {
      stroke: var(--global-text-color-light);
      stroke-width: 1;
    }
    .cfd-curve {
      transition: opacity 0.25s ease;
    }
    .cfd-curve.cfd-dim {
      opacity: 0.15;
    }
    .cfd-mean-label {
      font-size: 11px;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .cfd-curve.cfd-focus .cfd-mean-label {
      opacity: 1;
    }
    /* The marker: a line through the plot and a fixed-size handle on the axis. */
    .cfd-marker-line {
      stroke: var(--global-text-color);
      stroke-opacity: 0.7;
      stroke-width: 1.5;
    }
    .cfd-marker {
      outline: none;
    }
    .cfd-handle {
      fill: var(--global-bg-color);
      stroke: var(--global-text-color);
      stroke-width: 1.5;
    }
    .cfd-grip {
      stroke: var(--global-text-color);
      stroke-width: 1.25;
      stroke-linecap: round;
    }
    .cfd-marker:focus-visible .cfd-handle {
      stroke: var(--global-theme-color);
      stroke-width: 2.5;
    }
    /* The panel: a note and a square grid, one block per model with its nearest sample, from the top. */
    .cfd-panel {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-content: start;
      gap: 0.75rem;
      min-width: 0;
    }
    .cfd-panel-note {
      grid-column: 1 / -1;
      font-size: 0.8rem;
      line-height: 1.4;
      color: var(--global-text-color-light);
    }
    .cfd-block {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
    .cfd-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 0.5rem;
      margin-bottom: 0.2rem;
      line-height: 1.3;
    }
    .cfd-name {
      font-size: 0.9rem;
      font-weight: 700;
    }
    /* The real image of a pair: a neutral frame and label. */
    .cfd-real .cfd-name {
      color: var(--global-text-color-light);
    }
    .cfd-real .cfd-strip {
      border-color: var(--global-text-color-light);
    }
    .cfd-strip {
      display: grid;
      padding: 3px;
      border: 2px solid;
      border-radius: 8px;
    }
    /* A tile's images share one cell, so a new one fades in over the old. */
    .cfd-strip img {
      grid-area: 1 / 1;
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      border-radius: 3px;
      object-fit: cover;
      background: var(--global-divider-color);
    }
    .cfd-strip img.cfd-in {
      animation: cfd-fade 0.25s ease;
    }
    @keyframes cfd-fade {
      from {
        opacity: 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .cfd-strip img.cfd-in {
        animation: none;
      }
    }
  </style>
{%- endunless %}
<div class="cfd ch-box l-page{% if include.stack %} cfd-stack{% endif %}" data-fidelity-density>
  <div class="cfd-body">
    <div class="cfd-plot">
      <div class="cfd-bar">
        <label class="cfd-pick ch-field" hidden>
          <span class="ch-label">Class</span>
          <span class="ch-select"><select class="cfd-class"></select></span>
        </label>
        <div class="cfd-key" role="list" aria-label="Key"></div>
      </div>
      <svg class="cfd-chart" role="group"></svg>
    </div>
    <div class="cfd-panel">
      <div class="cfd-panel-note">{{ cfd_note }}</div>
    </div>
  </div>
  <script type="application/json" class="cfd-data">
    {
      "data": {{ site.data[cfd_data] | jsonify }},
      "images": {{ cfd_images | relative_url | jsonify }}
    }
  </script>
</div>
{%- if include.caption %}
  <div class="caption ch-caption">{{ include.caption }}</div>
{%- endif %}
{%- unless cfd_assets_added %}
  <script defer src="{{ '/assets/js/chamfer-fidelity-density.js' | relative_url }}"></script>
  {%- assign cfd_assets_added = true -%}
{%- endunless %}
